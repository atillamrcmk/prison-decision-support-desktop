<Window x:Class="KKDS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KKDS.ViewModels"
        Title="KKDS — Kurul Karar Destek Sistemi"
        Height="800" Width="1200" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" Width="220"
                Visibility="{Binding GirisYapildi, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="14,18,14,8">
                    <TextBlock Text="KKDS" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Kurul Karar Destek Sistemi" FontSize="10" Foreground="#78909C" Margin="0,2,0,0"/>
                    <Border Height="1" Background="#37474F" Margin="0,14,0,10"/>
                    <TextBlock Text="{Binding KullaniciAdi}" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RolAdi}" FontSize="10" Foreground="#78909C" Margin="0,2,0,0"/>
                    <Border Height="1" Background="#37474F" Margin="0,10,0,6"/>
                </StackPanel>

                <!-- Logout -->
                <Button DockPanel.Dock="Bottom" Content="Çıkış Yap" Command="{Binding CikisCommand}"
                        Style="{StaticResource SidebarButton}" Foreground="#EF9A9A" Margin="4,0,4,14"/>

                <!-- Menu Items -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Komut}" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Ikon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Baslik}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="White" Padding="20,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding GirisYapildi, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="{Binding SayfaBasligi}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AltBilgi}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="16,12">
                    <ContentControl Content="{Binding CurrentView}"/>
                </ScrollViewer>
                <Border Background="#F3F6FA" Padding="28" Visibility="{Binding CurrentView.YetkisizMod, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding CurrentView.YetkisizAciklama}" TextWrapping="Wrap" FontSize="14"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="White" Padding="12,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding GirisYapildi, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="KKDS Pilot — Veri klasörü: Ayarlar menüsünden yapılandırılır (JSON depolama)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="Offline Mod" FontSize="10" Foreground="{StaticResource SuccessBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
