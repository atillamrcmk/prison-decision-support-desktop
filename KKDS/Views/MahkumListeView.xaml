<UserControl x:Class="KKDS.Views.MahkumListeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MinWidth="860">
        <!-- Filters -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Arama" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Blok" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding BlokListesi}" SelectedItem="{Binding SeciliBlok}" Width="120"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Durum" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DurumListesi}" SelectedItem="{Binding SeciliDurum}" Width="120"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- List -->
        <Border Style="{StaticResource CardBorder}">
            <DataGrid ItemsSource="{Binding Mahkumlar}" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mahkum Kodu" Binding="{Binding MahkumKodu}"/>
                    <DataGridTextColumn Header="Blok" Binding="{Binding Blok}"/>
                    <DataGridTextColumn Header="Koğuş" Binding="{Binding Kogus}"/>
                    <DataGridTextColumn Header="Durum" Binding="{Binding Durum}"/>
                    <DataGridTextColumn Header="Son Olay" Binding="{Binding SonOlayTarihi}"/>
                    <DataGridTextColumn Header="Son Karar" Binding="{Binding SonKurulKarari}"/>
                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskSkoru, StringFormat=F1}"/>
                    <DataGridTextColumn Header="Seviye" Binding="{Binding RiskSeviye}"/>
                    <DataGridTemplateColumn Header="Eğilim">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Egilim, Converter={StaticResource EgilimSimge}}"
                                           Foreground="{Binding Egilim, Converter={StaticResource EgilimRenk}}"
                                           FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Detay" Style="{StaticResource SmallButton}"
                                        Command="{Binding DataContext.DetayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding MahkumId}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
