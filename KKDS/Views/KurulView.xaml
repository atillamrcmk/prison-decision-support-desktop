<UserControl x:Class="KKDS.Views.KurulView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MinWidth="860">
        <!-- Summary Band -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="20">
            <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Kurul Toplantısı" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Tarih}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Toplam Vaka" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ToplamVaka}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <Border Background="#FECACA" CornerRadius="6" Padding="12,4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#991B1B" FontSize="13" FontWeight="SemiBold">
                        <Run Text="Öncelikli: "/><Run Text="{Binding OncelikliSayisi, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
                <Border Background="#FEF3C7" CornerRadius="6" Padding="12,4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#92400E" FontSize="13" FontWeight="SemiBold">
                        <Run Text="İzlem: "/><Run Text="{Binding IzlemSayisi, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
                <Border Background="#D1FAE5" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                    <TextBlock Foreground="#065F46" FontSize="13" FontWeight="SemiBold">
                        <Run Text="Stabil: "/><Run Text="{Binding StabilSayisi, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"
                       Text="Öncelik sınıfı; risk analizi, olay yoğunluğu, psikolog/revir durumu ve kurul kararı etkisine göre kural tabanlıdır. Yüksek, orta veya düşük etiketi otomatik karar değildir; listedeki nedenler özet bilgidir."/>
            </StackPanel>
        </Border>

        <!-- Priority Cases (Red) -->
        <TextBlock Text="ÖNCELİKLİ VAKALAR" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="4,0,0,8"/>
        <ItemsControl ItemsSource="{Binding OncelikliVakalar}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" BorderBrush="#DC3545" BorderThickness="1,1,4,1" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding MahkumKodu}" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ÖNCELİKLİ" FontSize="10" Foreground="#991B1B" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Blok}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Son 30 Gün" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock FontSize="13" FontWeight="SemiBold">
                                            <Run Text="{Binding Son30GunOlay, Mode=OneWay}"/><Run Text=" olay"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Son Karar" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SonKarar}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Eğilim" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Egilim}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding Egilim, Converter={StaticResource EgilimRenk}}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Beklenen (7g)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding BeklenenOlay, StringFormat=F1}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Priority Reasons -->
                                <Border Background="#FFF5F5" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Öncelik Nedenleri:" FontSize="11" FontWeight="SemiBold" Foreground="#991B1B" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding OncelikNedenleriMetin}" FontSize="11" Foreground="#7F1D1D" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding SistemYorumuMetni}" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Risk Badge + Detail Button -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,0,0,0">
                                <Border CornerRadius="8" Padding="12,8"
                                        Background="{Binding RiskSeviye, Converter={StaticResource RiskRenk}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RiskSkoru, StringFormat=F0}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RiskSeviye}" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="Detaya Git" Style="{StaticResource SmallButton}" Margin="0,8,0,0"
                                        Command="{Binding DataContext.DetayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding MahkumId}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Watch Cases (Yellow) -->
        <TextBlock Text="YAKIN İZLEM VAKALARI" FontSize="14" FontWeight="Bold" Foreground="#E65100" Margin="4,12,0,8"/>
        <ItemsControl ItemsSource="{Binding IzlemVakalari}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" BorderBrush="#FFC107" BorderThickness="1,1,4,1" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding MahkumKodu}" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="İZLEM" FontSize="10" Foreground="#92400E" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Blok}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <UniformGrid Columns="4" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Son 30 Gün" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock FontSize="13" FontWeight="SemiBold">
                                            <Run Text="{Binding Son30GunOlay, Mode=OneWay}"/><Run Text=" olay"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Son Karar" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SonKarar}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Eğilim" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Egilim}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding Egilim, Converter={StaticResource EgilimRenk}}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Beklenen (7g)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding BeklenenOlay, StringFormat=F1}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="{Binding SistemYorumuMetni}" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,0,0,0">
                                <Border CornerRadius="8" Padding="12,8"
                                        Background="{Binding RiskSeviye, Converter={StaticResource RiskRenk}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RiskSkoru, StringFormat=F0}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RiskSeviye}" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="Detaya Git" Style="{StaticResource SmallButton}" Margin="0,8,0,0"
                                        Command="{Binding DataContext.DetayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding MahkumId}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Stable Cases (Green) -->
        <TextBlock Text="STABİL VAKALAR" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="4,12,0,8"/>
        <ItemsControl ItemsSource="{Binding StabilVakalar}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6" BorderBrush="#28A745" BorderThickness="1,1,4,1" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MahkumKodu}" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Blok}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="Risk: "/><Run Text="{Binding RiskSkoru, Mode=OneWay, StringFormat=F0}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SistemYorumuMetni}" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="16,0,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="400" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Detay" Style="{StaticResource SmallButton}"
                                    Command="{Binding DataContext.DetayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding MahkumId}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
