<UserControl x:Class="KKDS.Views.KurulKarariFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Form: Yeni Kurul Kararı -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Yeni Kurul Kararı Oluştur" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Karar oluşturulduktan sonra Psikolog, Revir ve Disiplin birimlerinin onayına sunulur." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="Mahkum Kodu" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MahkumKodu, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                        <TextBlock Text="Karar Tarihi" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding Tarih}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="Karar Türü" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding KararTurleriListesi}" SelectedItem="{Binding KararTuru}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                        <TextBlock Style="{StaticResource LabelStyle}">
                            <Run Text="Süre (gün): "/><Run Text="{Binding SureGun, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <Slider Minimum="1" Maximum="60" Value="{Binding SureGun}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="Kısa Gerekçe" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding KisaGerekce, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10">
                        <TextBlock Text="Detaylı Gerekçe (opsiyonel)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding DetayliGerekce}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="Gözden Geçirme Tarihi (opsiyonel)" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding GozdenGecirmeTarihi}"/>
                    </StackPanel>
                </Grid>

                <!-- Mesaj -->
                <TextBlock Text="{Binding Mesaj}" FontSize="12" Margin="0,4,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MesajHata}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Temizle" Command="{Binding TemizleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="Karar Oluştur ve Onaya Sun" Command="{Binding KaydetCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Mevcut Kararlar Listesi -->
        <Border Style="{StaticResource CardBorder}" Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Mevcut Kurul Kararları" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10">
                    <Run Text="{Binding MevcutKararlar.Count, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" karar listeleniyor"/>
                </TextBlock>
                <DataGrid ItemsSource="{Binding MevcutKararlar}" MaxHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding KararTarihi, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTextColumn Header="Mahkum" Binding="{Binding MahkumKodu}"/>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding MahkumAd}"/>
                        <DataGridTextColumn Header="Karar Türü" Binding="{Binding KararTuru}"/>
                        <DataGridTextColumn Header="Süre" Binding="{Binding SureGun}"/>
                        <DataGridTextColumn Header="Gerekçe" Binding="{Binding KisaGerekce}"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding OnayDurumuMetin}"/>
                        <DataGridTextColumn Header="Onay" Binding="{Binding OnayOzet}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
