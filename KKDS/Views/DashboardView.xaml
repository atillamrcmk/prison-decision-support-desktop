<UserControl x:Class="KKDS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="DataGridTextBlockWrap" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <StackPanel MinWidth="860">
        <!-- Summary Cards Row -->
        <UniformGrid Columns="4" Margin="0,0,0,12">
            <!-- Toplam Mahkum -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Toplam Mahkum" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ToplamMahkum}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>
            <!-- Son 30 Gün Olay -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Son 30 Gün Olay" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Son30GunOlay}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
            <!-- Son 30 Gün Karar -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Son 30 Gün Karar" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Son30GunKarar}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <!-- Yakın İzlem -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Yakın İzlem" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding YakinIzlemSayisi}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Analytic Cards Row -->
        <UniformGrid Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Olumlu Etki (Kalıcı)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding OlumluVakaSayisi}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="vaka" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Tekrar Yükseliş" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TekrarYukselisSayisi}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="vaka" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="En Yoğun Zaman" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding EnYogunZamanDilimi}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="En Sık Olay Türü" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding EnSikOlayTuru}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Critical Alerts Row -->
        <UniformGrid Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1,1,1,3">
                <StackPanel>
                    <TextBlock Text="En Yüksek Risk" FontSize="11" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding EnYuksekRiskMahkum}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Skor: "/><Run Text="{Binding EnYuksekRiskSkor, Mode=OneWay, StringFormat=F1}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1,1,1,3">
                <StackPanel>
                    <TextBlock Text="Hızlı Kötüleşen" FontSize="11" Foreground="#E65100" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding EnHizliKotuMahkum}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" BorderBrush="#9C27B0" BorderThickness="1,1,1,3">
                <StackPanel>
                    <TextBlock Text="Tehlikeli Örüntü" FontSize="11" Foreground="#9C27B0" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding EnTehlikeliOruntu}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Charts Row: sabit satır yüksekliği → * satırları ölçülür; iki kart simetrik dolar -->
        <Grid Margin="0,0,0,12" Height="440" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Global Karar Etki -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="0" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Karar Türü Etki Analizi" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"
                               TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left">
                        <Run Text="Aynı mahkumda karar tarihine göre önceki 7 gün ve sonraki 7 gün olay sayıları karşılaştırılır."/>
                        <LineBreak/>
                        <Run Text="Ort. değişim (%): önceki 7 günde en az bir olay varken hesaplanan yüzdelerin ortalaması."/>
                    </TextBlock>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding KararEtkileri}" MinHeight="120" VerticalAlignment="Stretch"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              RowHeaderWidth="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding KararTuru}" MinWidth="150" Width="*"
                                                ElementStyle="{StaticResource DataGridTextBlockWrap}">
                                <DataGridTextColumn.Header>
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" ToolTip="Kurul kararının türü">
                                        Karar türü
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ToplamKarar}" MinWidth="56" Width="Auto">
                                <DataGridTextColumn.Header>
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" ToolTip="Bu türden verilen toplam karar sayısı">
                                        Toplam
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding YuzdeDeğişim, StringFormat=F1}" MinWidth="88" Width="Auto">
                                <DataGridTextColumn.Header>
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="100"
                                               ToolTip="Önceki dönemde en az bir olay kaydı olan kararlarda, 7 günlük olay sayısındaki yüzde değişimin ortalaması">
                                        Ort. değişim (%)
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding OlumluSayi}" MinWidth="72" Width="Auto">
                                <DataGridTextColumn.Header>
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="90"
                                               ToolTip="Sonraki 7 günde olay sayısı önceki 7 güne göre azalan kararlar">
                                        Olumlu (azalış)
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding OlumsuzSayi}" MinWidth="78" Width="Auto">
                                <DataGridTextColumn.Header>
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="96"
                                               ToolTip="Sonraki 7 günde olay sayısı önceki 7 güne göre artan kararlar">
                                        Olumsuz (artış)
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding EtkisizSayi}" MinWidth="56" Width="Auto">
                                <DataGridTextColumn.Header>
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="80"
                                               ToolTip="Önce ve sonra aynı olay sayısı (etki yok)">
                                        Nötr
                                    </TextBlock>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Olay trendi: grafik kutusu * ile sol tablo yüksekliğine yayılır -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="1" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TrendGrafikBaslik}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ComboBox Grid.Column="1" MinWidth="200" Margin="12,0,0,0" VerticalAlignment="Center"
                                  ItemsSource="{Binding TrendPeriyotSecenekleri}"
                                  DisplayMemberPath="Ad"
                                  SelectedValuePath="Deger"
                                  SelectedValue="{Binding TrendPeriyot, Mode=TwoWay}"/>
                    </Grid>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                               Text="{Binding TrendGrafikAciklama}"/>
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,10,10,8" VerticalAlignment="Stretch" MinHeight="160">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="120"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" VerticalAlignment="Stretch" MinHeight="120">
                                <Grid Margin="0,4,0,0" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="1" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="2" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="3" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HaftalikTrendler}" VerticalAlignment="Bottom" Margin="4,0,4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3,0">
                                                <TextBlock Text="{Binding OlaySayisi}" FontSize="11" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <Border Width="30" CornerRadius="4,4,0,0" Margin="0,6,0,0"
                                                        Background="{Binding CubukRenkHex, Converter={StaticResource HexToBrush}}"
                                                        Height="{Binding OlaySayisi, Converter={StaticResource BarHeight}, ConverterParameter=7}" MinHeight="6" MaxHeight="120"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Border Grid.Row="1" Height="2" Background="#475569" CornerRadius="1" Margin="0,4,0,0"/>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding HaftalikTrendler}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Hafta}" FontSize="7" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="104"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Most Problematic Inmates -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="En Problemli 5 Mahkum" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding EnProblemliMahkumlar}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mahkum Kodu" Binding="{Binding MahkumKodu}"/>
                        <DataGridTextColumn Header="Blok" Binding="{Binding Blok}"/>
                        <DataGridTextColumn Header="Risk Skoru" Binding="{Binding RiskSkoru, StringFormat=F1}"/>
                        <DataGridTextColumn Header="Seviye" Binding="{Binding RiskSeviye}"/>
                        <DataGridTextColumn Header="Son 30 Gün" Binding="{Binding Son30GunOlay}"/>
                        <DataGridTextColumn Header="Eğilim" Binding="{Binding Egilim}"/>
                        <DataGridTextColumn Header="Son Karar" Binding="{Binding SonKarar}"/>
                        <DataGridTemplateColumn Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Detay" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.DetayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding MahkumId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Fast Deteriorating -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                Visibility="{Binding HizliKotulesenler.Count, Converter={StaticResource NullToVis}}">
            <StackPanel>
                <TextBlock Text="Hızlı Kötüleşen Vakalar" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding HizliKotulesenler}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mahkum Kodu" Binding="{Binding MahkumKodu}"/>
                        <DataGridTextColumn Header="Blok" Binding="{Binding Blok}"/>
                        <DataGridTextColumn Header="Risk Skoru" Binding="{Binding RiskSkoru, StringFormat=F1}"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Egilim}"/>
                        <DataGridTemplateColumn Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Detay" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.DetayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding MahkumId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Son Olaylar -->
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Son Olaylar" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding SonOlaylar}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}"/>
                        <DataGridTextColumn Header="Mahkum" Binding="{Binding MahkumKodu}"/>
                        <DataGridTextColumn Header="Olay Türü" Binding="{Binding OlayTuru}"/>
                        <DataGridTextColumn Header="Şiddet" Binding="{Binding Siddet}"/>
                        <DataGridTextColumn Header="Zaman" Binding="{Binding ZamanDilimi}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
