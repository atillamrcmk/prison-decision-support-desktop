<UserControl x:Class="KKDS.Views.Acil112KayitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding FormBaslik}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"
                           Text="Mahkum, olayın geçtiği vardiya, 112'yi arayan nöbet vardiyası, şikâyet ve çağrı zamanını kaydedin. Tüm kurum çağrıları aşağıda süzülebilir."/>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="Mahkum kodu" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MahkumKodu, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                        <TextBlock Text="Çağrı tarihi" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding CagriTarih}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="Çağrı saati (ss:dd)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding CagriSaat, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                        <TextBlock Text="Olayın vardiyası" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding VardiyaListesi}" SelectedItem="{Binding Vardiya}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <TextBlock Text="112'yi arayan vardiya (çağrıyı yapan nöbet)" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding VardiyaListesi}" SelectedItem="{Binding CagiranVardiya}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <TextBlock Text="Şikâyet / başvuru nedeni" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Sikayet}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <TextBlock Text="Ek notlar (isteğe bağlı)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Notlar}" AcceptsReturn="True" TextWrapping="Wrap" Height="44"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Mesaj}" FontSize="12" Margin="0,4,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding MesajHata}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Temizle" Command="{Binding TemizleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="Sil" Command="{Binding SilCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" Visibility="{Binding DuzenleModu, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Güncelle" Command="{Binding GuncelleCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Visibility="{Binding DuzenleModu, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Kaydet" Command="{Binding KaydetCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding DuzenleModu, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Grid.Row="1">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Kurum geneli 112 çağrı kayıtları" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Mahkum kodu, ad soyad, şikâyet, olay veya arayan vardiyaya göre süzün." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="Süzgeç" Style="{StaticResource LabelStyle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding FiltreMetni, UpdateSourceTrigger=PropertyChanged}" Width="200" VerticalAlignment="Center"/>
                        <Button Content="Yenile" Command="{Binding ListeYenileCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding GorunenKayitlar}" MaxHeight="420" SelectionMode="Single"
                          MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Çağrı zamanı" Binding="{Binding CagriZamani, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Mahkum kodu" Binding="{Binding MahkumKodu}" Width="100"/>
                        <DataGridTextColumn Header="Ad soyad" Binding="{Binding MahkumAdSoyad}" Width="140"/>
                        <DataGridTextColumn Header="Olay vardiyası" Binding="{Binding Vardiya}" Width="110"/>
                        <DataGridTextColumn Header="112 arayan" Binding="{Binding CagiranVardiya}" Width="110"/>
                        <DataGridTextColumn Header="Şikâyet" Binding="{Binding Sikayet}"/>
                        <DataGridTextColumn Header="Not" Binding="{Binding Notlar}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
