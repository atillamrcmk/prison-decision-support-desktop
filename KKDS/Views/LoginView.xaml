<UserControl x:Class="KKDS.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
        <Border Style="{StaticResource CardBorder}" Padding="32">
            <StackPanel>
                <TextBlock Text="KKDS" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Kurul Karar Destek Sistemi" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <TextBlock Text="Kullanıcı Adı" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding KullaniciAdi, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Şifre" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="PwdBox" Margin="0,0,0,16" Padding="8,6" FontSize="13" PasswordChanged="PwdBox_PasswordChanged"/>

                <TextBlock Text="{Binding HataMesaji}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,10"
                           Visibility="{Binding HataMesaji, Converter={StaticResource NullToVis}}"/>

                <Button Content="Giriş Yap" Command="{Binding GirisCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,10"/>
                <TextBlock Text="Demo Kullanıcılar" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" LineHeight="18" TextWrapping="Wrap">
                    <Run Text="psikolog1 / 1234 — Psikolog"/><LineBreak/>
                    <Run Text="revir1 / 1234 — Revir"/><LineBreak/>
                    <Run Text="disiplin1 / 1234 — Disiplin"/><LineBreak/>
                    <Run Text="yonetici1 / 1234 — Yönetici"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
