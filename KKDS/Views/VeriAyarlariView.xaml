<UserControl x:Class="KKDS.Views.VeriAyarlariView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="Veri klasörü" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"
                       Text="Tüm JSON kayıtları bu klasör altında tutulur. Paylaşımlı ağ yolu da kullanılabilir. Değişiklikten sonra veri otomatik yeniden yüklenir."/>
            <TextBlock Text="Klasör yolu" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding VeriYoluGosterim, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Kaydet ve uygula" Style="{StaticResource PrimaryButton}" Command="{Binding KaydetCommand}" Margin="0,0,8,0"/>
                <Button Content="Varsayılan (%LocalAppData%\KKDS\Veri)" Style="{StaticResource SecondaryButton}" Command="{Binding VarsayilanCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Mesaj}" Margin="0,12,0,0" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MesajHata}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
