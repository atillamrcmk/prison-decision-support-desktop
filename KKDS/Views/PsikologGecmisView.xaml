<UserControl x:Class="KKDS.Views.PsikologGecmisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Filtrele" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Mahkum Kodu" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Başlangıç" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding BaslangicTarihi}" Width="140"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Bitiş" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding BitisTarihi}" Width="140"/>
                    </StackPanel>
                    <Button Content="Temizle" Command="{Binding TemizleCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8">
                    <Run Text="Toplam: "/><Run Text="{Binding Kayitlar.Count, Mode=OneWay}" FontWeight="Bold"/><Run Text=" kayıt"/>
                </TextBlock>
                <DataGrid ItemsSource="{Binding Kayitlar}" MaxHeight="500">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding DegerlendirmeTarihi, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTextColumn Header="Mahkum" Binding="{Binding MahkumKodu}"/>
                        <DataGridTextColumn Header="Ruh Hali" Binding="{Binding RuhHali}"/>
                        <DataGridTextColumn Header="Agresyon" Binding="{Binding AgresyonDuzeyi}"/>
                        <DataGridTextColumn Header="Zarar" Binding="{Binding KendineZararRiski}"/>
                        <DataGridTextColumn Header="İşbirliği" Binding="{Binding Isbirligi}"/>
                        <DataGridTextColumn Header="Değişim" Binding="{Binding OncekiDurumaGore}"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
