<UserControl x:Class="KKDS.Views.MahkumDetayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MinWidth="860">
        <!-- Header Band -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Mahkum.MahkumKodu}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <Border Background="#E5E7EB" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Mahkum.Blok}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#E5E7EB" CornerRadius="4" Padding="8,3" Margin="4,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="11"><Run Text="Koğuş "/><Run Text="{Binding Mahkum.Kogus, Mode=OneWay}"/></TextBlock>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Son Kurul Kararı: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.KararEtkisi.SonKararTuru}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="  |  Eğilim: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Analiz.Egilim}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding Analiz.Egilim, Converter={StaticResource EgilimRenk}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border CornerRadius="8" Padding="16,8"
                            Background="{Binding Risk.Seviye, Converter={StaticResource RiskRenk}}"
                            ToolTip="Bu skor olay yoğunluğu, şiddet, psikolog ve sağlık verilerine göre hesaplanır. Karar vermez; destek amaçlıdır.">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Risk.ToplamSkor, StringFormat=F0}" FontSize="28" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Risk.Seviye}" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Detayı PDF olarak dışa aktar" Command="{Binding DisaAktarPdfCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                            ToolTip="Önemli veriler A4 PDF olarak kaydedilir."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row: 7-Day Prediction + Risk Score Details -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 7-Day Prediction -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1,1,1,3"
                    ToolTip="Bu tahmin son veriler üzerinden kural tabanlı olarak üretilmiştir; istatistiksel model değildir.">
                <StackPanel>
                    <TextBlock Text="7 Günlük Risk Tahmini" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="Beklenen Olay" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Tahmin.BeklenenOlaySayisi, StringFormat=F1}" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="Olasılık" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock FontSize="22" FontWeight="Bold">
                                <Run Text="%"/><Run Text="{Binding Tahmin.Olasilik, Mode=OneWay, StringFormat=F0}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="En Riskli Zaman" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Tahmin.EnRiskliZaman}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="Beklenen Tür" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Tahmin.BeklenenOlayTuru}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                            <TextBlock Text="Güven Aralığı" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock FontSize="13">
                                <Run Text="{Binding Tahmin.AltSinir, Mode=OneWay, StringFormat=F1}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Tahmin.UstSinir, Mode=OneWay, StringFormat=F1}"/>
                                <Run Text=" olay"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Etkileyen Faktörler:" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <ItemsControl ItemsSource="{Binding Tahmin.EtkiFactorleri}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,1">
                                    <Run Text="• "/><Run Text="{Binding Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"
                               Text="Bu tahmin son olay ve sağlık verilerine göre kural tabanlıdır; istatistiksel tahmin modeli değildir."/>
                </StackPanel>
            </Border>

            <!-- Risk Score Details -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Risk Skoru Bileşenleri" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Component bars -->
                    <StackPanel Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Olay Yoğunluğu (%35)" FontSize="11" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding Risk.OlayYogunlugu, StringFormat=F0}" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Height="8" CornerRadius="4" Background="#E5E7EB">
                            <Border Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" Width="{Binding Risk.OlayYogunlugu}" MaxWidth="300"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Şiddet Ortalaması (%25)" FontSize="11" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding Risk.SiddetOrtalamasi, StringFormat=F0}" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Height="8" CornerRadius="4" Background="#E5E7EB">
                            <Border Height="8" CornerRadius="4" Background="#F59E0B"
                                    HorizontalAlignment="Left" Width="{Binding Risk.SiddetOrtalamasi}" MaxWidth="300"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Psikolog Riski (%20)" FontSize="11" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding Risk.PsikologRiski, StringFormat=F0}" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Height="8" CornerRadius="4" Background="#E5E7EB">
                            <Border Height="8" CornerRadius="4" Background="#EF4444"
                                    HorizontalAlignment="Left" Width="{Binding Risk.PsikologRiski}" MaxWidth="300"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Revir Riski (%10)" FontSize="11" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding Risk.RevirRiski, StringFormat=F0}" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Height="8" CornerRadius="4" Background="#E5E7EB">
                            <Border Height="8" CornerRadius="4" Background="#8B5CF6"
                                    HorizontalAlignment="Left" Width="{Binding Risk.RevirRiski}" MaxWidth="300"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Trend Artışı (%10)" FontSize="11" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding Risk.TrendArtisi, StringFormat=F0}" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border Height="8" CornerRadius="4" Background="#E5E7EB">
                            <Border Height="8" CornerRadius="4" Background="#10B981"
                                    HorizontalAlignment="Left" Width="{Binding Risk.TrendArtisi}" MaxWidth="300"/>
                        </Border>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"
                               Text="Risk skoru; olay yoğunluğu, şiddet, psikolog ve revir risk bileşenleri ile trend artışından hesaplanır. Sistem karar vermez; destek amaçlı göstergedir."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5 Risk Dimensions -->
        <UniformGrid Columns="5" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Davranışsal" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Analiz.RiskBoyutlari.Davranissal}" FontSize="16" FontWeight="Bold"
                               Foreground="{Binding Analiz.RiskBoyutlari.Davranissal, Converter={StaticResource RiskRenk}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Psikolojik" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Analiz.RiskBoyutlari.Psikolojik}" FontSize="16" FontWeight="Bold"
                               Foreground="{Binding Analiz.RiskBoyutlari.Psikolojik, Converter={StaticResource RiskRenk}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Sağlık" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Analiz.RiskBoyutlari.Saglik}" FontSize="16" FontWeight="Bold"
                               Foreground="{Binding Analiz.RiskBoyutlari.Saglik, Converter={StaticResource RiskRenk}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Tekrar" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Analiz.RiskBoyutlari.Tekrar}" FontSize="16" FontWeight="Bold"
                               Foreground="{Binding Analiz.RiskBoyutlari.Tekrar, Converter={StaticResource RiskRenk}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Kurul Önceliği" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Analiz.RiskBoyutlari.KurulOnceligi}" FontSize="16" FontWeight="Bold"
                               Foreground="{Binding Analiz.RiskBoyutlari.KurulOnceligi, Converter={StaticResource RiskRenk}}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Stats Row -->
        <UniformGrid Columns="5" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Toplam Olay" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ToplamOlay}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Karar Öncesi" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding KararOncesiOlay}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Karar Sonrası" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding KararSonrasiOlay}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Psikolog" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding PsikologDurum}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Revir" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding RevirDurum}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Karar etkisi (7 gün penceresi) -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1,1,1,3">
            <StackPanel>
                <TextBlock Text="Karar etkisi (son kurul kararı)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                           Text="Son kayıtlı kurul kararına göre karar tarihinden önceki 7 gün ile karar ve sonrası 7 gün içindeki disiplin olay sayıları karşılaştırılır."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Karar" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.KararEtkisi.SonKararTuru}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Önce (7 gün)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.KararEtkisi.Oncesi7Gun}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Sonra (7 gün)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.KararEtkisi.Sonrasi7Gun}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Etki özeti" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.KararEtkisi.EtkiSonuc7Gun}" FontSize="14" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Analiz.KararEtkisi.EtkiSonuc7Gun}" Value="Olumlu">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Analiz.KararEtkisi.EtkiSonuc7Gun}" Value="Olumsuz">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Pattern Analysis Card -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Örüntü Analizi" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="En Sık Olay Türü" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.Oruntu.EnSikOlayTuru}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="En Riskli Zaman" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.Oruntu.EnRiskliZamanDilimi}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="En Sık Hedef" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.Oruntu.EnSikHedef}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Sözelden Fiziksele" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Hayır"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Analiz.Oruntu.SozdenFizikseleEvrim}" Value="True">
                                            <Setter Property="Text" Value="EVET — Tespit Edildi"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Tekrar Eden Döngü" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Analiz.Oruntu.TekrarDonguDetay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Karar Etkisi" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Veri yetersiz"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Analiz.KararEtkisi.KaliciEtki}" Value="True">
                                            <Setter Property="Text" Value="Kalıcı etki var"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Analiz.KararEtkisi.TekrarYukselisi}" Value="True">
                                            <Setter Property="Text" Value="Tekrar yükselişe geçti"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Charts Row -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Olay trendi -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="0" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Top">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TrendGrafikBaslik}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ComboBox Grid.Column="1" MinWidth="190" Margin="10,0,0,0" VerticalAlignment="Center"
                                  ItemsSource="{Binding TrendPeriyotSecenekleri}"
                                  DisplayMemberPath="Ad"
                                  SelectedValuePath="Deger"
                                  SelectedValue="{Binding TrendPeriyot, Mode=TwoWay}"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"
                               Text="{Binding TrendGrafikAciklama}"/>
                    <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,10,10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="112"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Height="112">
                                <Grid Margin="0,4,0,0" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="1" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="2" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="3" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HaftalikTrendler}" VerticalAlignment="Bottom" Margin="4,0,4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3,0">
                                                <TextBlock Text="{Binding OlaySayisi}" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                <Border Width="26" CornerRadius="4,4,0,0" Margin="0,4,0,0"
                                                        Background="{Binding CubukRenkHex, Converter={StaticResource HexToBrush}}"
                                                        Height="{Binding OlaySayisi, Converter={StaticResource BarHeight}, ConverterParameter=8}" MinHeight="4" MaxHeight="76"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Border Grid.Row="1" Height="2" Background="#475569" CornerRadius="1" Margin="0,4,0,0"/>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding HaftalikTrendler}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Hafta}" FontSize="7" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="100"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Event Type Distribution -->
            <Border Style="{StaticResource CardBorder}" Grid.Column="1" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Olay Türü Dağılımı" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding OlayTurDagilimi}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="{Binding Sayi}" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
                                    <TextBlock Text="{Binding Tur}" FontSize="11" Width="140" DockPanel.Dock="Left"/>
                                    <Border Height="12" CornerRadius="3" Background="#E5E7EB" Margin="8,0">
                                        <Border Height="12" CornerRadius="3" Background="{StaticResource AccentBrush}"
                                                HorizontalAlignment="Left" MinWidth="4" MaxWidth="150"
                                                Width="{Binding Sayi, Converter={StaticResource BarHeight}, ConverterParameter=12}"/>
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- System Summary -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1,1,4,1">
            <StackPanel>
                <TextBlock Text="Sistem Değerlendirmesi" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Analiz.SistemYorumuMetni}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"
                           Foreground="{StaticResource TextBrush}"/>
                <ItemsControl ItemsSource="{Binding Analiz.SistemOzeti}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,3" LineHeight="20">
                                <Run Text="▸ "/><Run Text="{Binding Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Zaman akışı -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Zaman akışı" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"
                           Text="Disiplin, psikolog ve revir kayıtları birleştirilerek kronolojik gösterilir (en fazla 15 kayıt)."/>
                <ItemsControl ItemsSource="{Binding ZamanAkisi}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Top" Margin="0,4,0,0"
                                        Background="{StaticResource AccentBrush}"/>
                                <Border Grid.Column="1" Width="2" Background="#E2E8F0" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding TarihMetni, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Kaynak, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Baslik}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="#F8FAFC" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ZamanAkisiSonuc}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#334155"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Tab Buttons -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Olaylar" Command="{Binding SekmeCommand}" CommandParameter="0"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                    <Button Content="Psikolog" Command="{Binding SekmeCommand}" CommandParameter="1"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                    <Button Content="Revir" Command="{Binding SekmeCommand}" CommandParameter="2"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                    <Button Content="Kurul Kararları" Command="{Binding SekmeCommand}" CommandParameter="3"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>

                <!-- Tab 0: Olaylar -->
                <DataGrid ItemsSource="{Binding Olaylar}" MaxHeight="300">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeciliSekme}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding OlayTarihi, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTextColumn Header="Olay Türü" Binding="{Binding OlayTuru}"/>
                        <DataGridTextColumn Header="Şiddet" Binding="{Binding Siddet}"/>
                        <DataGridTextColumn Header="Hedef" Binding="{Binding Hedef}"/>
                        <DataGridTextColumn Header="Zaman" Binding="{Binding ZamanDilimi}"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tab 1: Psikolog -->
                <DataGrid ItemsSource="{Binding PsikologKayitlari}" MaxHeight="300">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeciliSekme}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding DegerlendirmeTarihi, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTextColumn Header="Ruh Hali" Binding="{Binding RuhHali}"/>
                        <DataGridTextColumn Header="Agresyon" Binding="{Binding AgresyonDuzeyi}"/>
                        <DataGridTextColumn Header="Zarar Riski" Binding="{Binding KendineZararRiski}"/>
                        <DataGridTextColumn Header="İşbirliği" Binding="{Binding Isbirligi}"/>
                        <DataGridTextColumn Header="Değişim" Binding="{Binding OncekiDurumaGore}"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tab 2: Revir -->
                <DataGrid ItemsSource="{Binding RevirKayitlari}" MaxHeight="300">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeciliSekme}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding KayitTarihi, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTextColumn Header="Uyku" Binding="{Binding UykuDurumu}"/>
                        <DataGridTextColumn Header="İlaç Uyumu" Binding="{Binding IlacUyumu}"/>
                        <DataGridTextColumn Header="Stres" Binding="{Binding StresSeviyesi}"/>
                        <DataGridTextColumn Header="Davranış Etkisi" Binding="{Binding DavranisEtkisi}"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tab 3: Kurul Kararları -->
                <DataGrid ItemsSource="{Binding KurulKararlari}" MaxHeight="300">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeciliSekme}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding KararTarihi, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTextColumn Header="Karar Türü" Binding="{Binding KararTuru}"/>
                        <DataGridTextColumn Header="Süre (Gün)" Binding="{Binding SureGun}"/>
                        <DataGridTextColumn Header="Gerekçe" Binding="{Binding KisaGerekce}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
