<UserControl x:Class="KKDS.Views.RevirGecmisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Filtrele" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Mahkum Kodu" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" Width="160"/></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Başlangıç" Style="{StaticResource LabelStyle}"/><DatePicker SelectedDate="{Binding BaslangicTarihi}" Width="140"/></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Bitiş" Style="{StaticResource LabelStyle}"/><DatePicker SelectedDate="{Binding BitisTarihi}" Width="140"/></StackPanel>
                    <Button Content="Temizle" Command="{Binding TemizleCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"><Run Text="Toplam: "/><Run Text="{Binding Kayitlar.Count, Mode=OneWay}" FontWeight="Bold"/><Run Text=" kayıt"/></TextBlock>
                <DataGrid ItemsSource="{Binding Kayitlar}" MaxHeight="500">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding KayitTarihi, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTextColumn Header="Mahkum" Binding="{Binding MahkumKodu}"/>
                        <DataGridTextColumn Header="Uyku" Binding="{Binding UykuDurumu}"/>
                        <DataGridTextColumn Header="İlaç" Binding="{Binding IlacUyumu}"/>
                        <DataGridTextColumn Header="Stres" Binding="{Binding StresSeviyesi}"/>
                        <DataGridTextColumn Header="Davranış" Binding="{Binding DavranisEtkisi}"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
