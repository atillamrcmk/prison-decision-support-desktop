<UserControl x:Class="KKDS.Views.KullaniciYonetimiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Sol: Kullanıcı Listesi -->
        <Border Style="{StaticResource CardBorder}" Grid.Column="0" Margin="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Sistemdeki Kullanıcılar" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10">
                    <Run Text="{Binding Kullanicilar.Count, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" kullanıcı kayıtlı. Düzenlemek için çift tıklayın."/>
                </TextBlock>

                <DataGrid ItemsSource="{Binding Kullanicilar}" MaxHeight="550" SelectionMode="Single"
                          MouseDoubleClick="Kullanicilar_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kullanıcı Adı" Binding="{Binding KullaniciAdi}"/>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding RolAdi}"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rol}" Value="yonetici">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Sağ: Form -->
        <Border Style="{StaticResource CardBorder}" Grid.Column="1">
            <StackPanel>
                <TextBlock Text="{Binding FormBaslik}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                <TextBlock Text="Kullanıcı Adı" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding KullaniciAdi, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding KullaniciAdiDuzenlenebilir}" Margin="0,0,0,10"/>

                <TextBlock Text="Ad Soyad" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding AdSoyad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Rol" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding RolListesi}" SelectedItem="{Binding SeciliRol}" Margin="0,0,0,10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="psikolog"><Setter Property="Text" Value="— Psikolog paneli"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="revir"><Setter Property="Text" Value="— Revir paneli"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="disiplin"><Setter Property="Text" Value="— Disiplin paneli"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="yonetici"><Setter Property="Text" Value="— Tam yetki"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Style="{StaticResource LabelStyle}" Margin="0,4,0,0">
                    <Run Text="Şifre"/>
                    <Run Text=" (düzenlemede boş bırakılırsa değişmez)" FontWeight="Normal" FontSize="10"/>
                </TextBlock>
                <PasswordBox x:Name="PwdBox" Margin="0,0,0,10" Padding="8,6" FontSize="13"
                             PasswordChanged="PwdBox_PasswordChanged"/>

                <TextBlock Text="Şifre Tekrar" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="PwdBox2" Margin="0,0,0,14" Padding="8,6" FontSize="13"
                             PasswordChanged="PwdBox2_PasswordChanged"/>

                <!-- Mesaj -->
                <TextBlock Text="{Binding Mesaj}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MesajHata}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Butonlar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Temizle" Command="{Binding TemizleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="Sil" Command="{Binding SilCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                            Visibility="{Binding DuzenleModu, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Güncelle" Command="{Binding GuncelleCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                            Visibility="{Binding DuzenleModu, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Oluştur" Command="{Binding KaydetCommand}" Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding DuzenleModu, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>

                <!-- Rol Açıklamaları -->
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,12"/>
                <TextBlock Text="Rol Yetkileri" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" LineHeight="17" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="psikolog:"/> <Run Text="Değerlendirme girişi, geçmiş kayıtlar, kurul onayı"/><LineBreak/>
                    <Run FontWeight="SemiBold" Text="revir:"/> <Run Text="Revir kaydı, geçmiş kayıtlar, kurul onayı"/><LineBreak/>
                    <Run FontWeight="SemiBold" Text="disiplin:"/> <Run Text="Olay kaydı, geçmiş kayıtlar, kurul onayı"/><LineBreak/>
                    <Run FontWeight="SemiBold" Text="yonetici:"/> <Run Text="Tüm paneller, analiz, kurul kararı, kullanıcı yönetimi"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
